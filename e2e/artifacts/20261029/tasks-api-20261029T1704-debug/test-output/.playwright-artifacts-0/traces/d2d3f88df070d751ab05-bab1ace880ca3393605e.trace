ter-spacing: -0.6px; }\n\n.connection {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  margin-left: auto;\n  padding: 8px 11px;\n  border: 1px solid #e4e8f1;\n  border-radius: 999px;\n  background: rgba(255,255,255,.75);\n  color: #65718a;\n  font-size: 12px;\n  white-space: nowrap;\n}\n\n.status-dot { width: 7px; height: 7px; border-radius: 50%; background: #d19b35; }\n.connection.online .status-dot { background: #2eae7d; }\n.connection.offline .status-dot { background: #d85858; }\n\n.welcome { padding: 62px 0 30px; }\n.welcome .eyebrow { color: #596bd6; }\n.welcome h2 { margin: 0; font-size: clamp(30px, 5vw, 42px); line-height: 1.18; letter-spacing: -1.8px; }\n.welcome-copy { margin: 12px 0 0; color: #778198; font-size: 15px; }\n\n.task-panel {\n  padding: 28px;\n  border: 1px solid #e8ebf3;\n  border-radius: 20px;\n  background: rgba(255,255,255,.94);\n  box-shadow: 0 18px 50px rgba(40, 52, 95, .055);\n}\n\n.panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; }\n.panel-heading h2 { margin: 0; font-size: 19px; letter-spacing: -.5px; }\n.muted { margin: 6px 0 0; color: #8790a4; font-size: 12px; }\n.count-pill { padding: 7px 11px; border-radius: 999px; background: #eef0ff; color: #4e60ce; font-size: 12px; font-weight: 700; }\n\n.task-form { display: flex; gap: 10px; margin: 24px 0 18px; }\n.task-form input {\n  width: 100%;\n  min-width: 0;\n  padding: 13px 15px;\n  border: 1px solid #e0e5ef;\n  border-radius: 11px;\n  outline: none;\n  background: #fbfcfe;\n  color: #20283a;\n  transition: border-color .15s, box-shadow .15s;\n}\n.task-form input:focus { border-color: #7787ec; box-shadow: 0 0 0 3px rgba(91, 110, 225, .12); }\n.task-form input::placeholder { color: #a2aabc; }\n.add-button { flex: 0 0 auto; padding: 0 17px; border: 0; border-radius: 11px; background: #4e63db; color: white; font-weight: 700; transition: background .15s, transform .15s; }\n.add-button:hover { background: #4054c8; }\n.add-button:active { transform: translateY(1px); }\n\n.error-message { margin: 0 0 14px; color: #bd3e4a; font-size: 13px; }\n.task-list { list-style: none; padding: 0; margin: 0; }\n.task-item { display: flex; align-items: center; gap: 12px; padding: 15px 2px; border-top: 1px solid #eef0f5; }\n.task-status { display: grid; place-items: center; flex: 0 0 22px; width: 22px; height: 22px; border: 1.5px solid #d7ddeb; border-radius: 7px; color: white; font-size: 13px; }\n.is-completed .task-status { border-color: #35ae83; background: #35ae83; }\n.task-title { flex: 1; overflow-wrap: anywhere; font-size: 14px; font-weight: 500; }\n.is-completed .task-title { color: #9ba3b3; text-decoration: line-through; }\n.complete-button { padding: 7px 11px; border: 1px solid #e1e5f0; border-radius: 8px; background: white; color: #66718a; font-size: 12px; font-weight: 600; }\n.complete-button:hover { border-color: #aab4ef; color: #4e63db; }\n.completed-label { color: #26936c; font-size: 12px; font-weight: 600; }\n.empty-state { display: grid; place-items: center; min-height: 120px; color: #8790a4; font-size: 13px; text-align: center; }\n.empty-icon { color: #7584e8; font-size: 25px; }\n.footer { display: flex; justify-content: space-between; gap: 12px; padding: 22px 4px 0; color: #9aa2b3; font-size: 11px; }\n.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }\n\n@media (max-width: 560px) {\n  .app-shell { width: min(100% - 24px, 820px); padding-top: 24px; }\n  .welcome { padding-top: 44px; }\n  .task-panel { padding: 19px; border-radius: 16px; }\n  .task-form { flex-direction: column; }\n  .add-button { min-height: 44px; }\n  .connection { font-size: 0; padding: 10px; }\n  .connection .status-dot { width: 8px; height: 8px; }\n  .footer { flex-wrap: wrap; }\n}\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["MAIN",{"class":"app-shell"},["HEADER",{"class":"topbar"},["DIV",{"class":"brand-m